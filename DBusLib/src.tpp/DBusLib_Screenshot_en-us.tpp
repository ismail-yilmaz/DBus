[s3; &]
[s2; This group of constants defines the strings specified by the 
XDG Desktop Portal standard ([C@5 org.freedesktop.portal.Desktop]) 
for taking screenshots.&]
[s3; &]
[s4; &]
[s5;:Upp`:`:StdDBusScreenshotName: [@(0.0.255) constexpr] [@(0.0.255) const] 
[@(0.0.255) char] [@(0.0.255) `*][* StdDBusScreenshotName ]`= `"[C@5 org.freedesktop.port
al.Desktop`"]&]
[s2;%% The well`-known bus name of the XDG Desktop Portal service. 
Used as the destination service name when routing portal requests 
on the session bus.&]
[s3; &]
[s4; &]
[s5;:Upp`:`:StdDBusScreenshotPath: [@(0.0.255) constexpr] [@(0.0.255) const] 
[@(0.0.255) char] [@(0.0.255) `*][* StdDBusScreenshotPath ]`= `"[C@5 /org/freedesktop/por
tal/Desktop`"]&]
[s2;%% The standard object path implemented by the portal daemon 
for handling desktop interactions.&]
[s3; &]
[s4; &]
[s5;:Upp`:`:StdDBusScreenshotInterface: [@(0.0.255) constexpr] [@(0.0.255) const] 
[@(0.0.255) char] [@(0.0.255) `*][* StdDBusScreenshotInterface ]`= 
`"[C@5 org.freedesktop.portal.Screenshot`"]&]
[s2;%% The core interface implemented by the portal daemon for screenshot 
operations. Invoking the [C@5 Screenshot ]method on this interface 
